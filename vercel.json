{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/jobs/trigger",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/jobs/queue-health",
      "schedule": "0 18 * * *"
    }
  ]
}
